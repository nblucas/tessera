# Copy to .env. Only DEMO_MODE is implemented; it fills demo defaults for the secrets below.
DEMO_MODE=true
DATABASE_URL=postgres://tessera:tessera@localhost:54329/tessera
PORT=3000
# ORACLE_PRIVATE_KEY=0x...
# RELAYER_PRIVATE_KEY=0x...  (must differ from the oracle key)
# PIX_WEBHOOK_SECRET=...
# FILES_DIR=./data/receipts
# COOKIE_SECURE=false
# Set to the local chain RPC to write to TesseraLedger instead of the fake ledger.
# LEDGER_RPC_URL=http://127.0.0.1:8545
